# Neon Postgres connection string — get it from https://console.neon.tech
# (Project → Connection Details → copy the pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# First admin user, created by `npm run db:seed`
SEED_ADMIN_NAME="Aaron Arvizu"
SEED_ADMIN_EMAIL="aaron.h.arvizu@gmail.com"
SEED_ADMIN_PASSWORD="change-me-now"

# OpenAI API key — powers the "Asistente" chat in Centro de Ayuda.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-replace-me"
# Optional: defaults to gpt-4o-mini if unset.
OPENAI_HELP_MODEL="gpt-4o-mini"

# Shared secret that authenticates the Recurrences scheduler
# (/api/cron/recurrences). Required in production: without it the route
# answers 503 and never runs, so nothing is generated automatically. Vercel
# Cron sends it as `Authorization: Bearer <CRON_SECRET>` on its own once the
# variable exists in the project. Generate with: openssl rand -hex 32
# See docs/architecture/background-jobs.md
CRON_SECRET="replace-me"
